local function stopFreecam()
	if not freecamActive then
		return
	end

	freecamActive = false
	freecamVelocity = Vector3.zero
	freecamButton.Text = "Freecam: OFF"
	freecamButton.BackgroundColor3 = COLORS.Accent
	freecamHint.Visible = false
	freecamSpeedLabel.Visible = false
	freecamIndicator.Visible = false

	if freecamConnection then
		freecamConnection:Disconnect()
		freecamConnection = nil
	end

	local camera = workspace.CurrentCamera
	if camera then
		camera.CameraType = previousCameraType or Enum.CameraType.Custom
		camera.CameraSubject = previousCameraSubject or humanoid
	end

	UserInputService.MouseIconEnabled = (previousMouseIconEnabled ~= false)
	UserInputService.MouseBehavior = previousMouseBehavior or Enum.MouseBehavior.Default

	-- Give WASD/jump back to the character.
	if playerControls then
		playerControls:Enable()
	end

	if freecamFrozenRoot then
		freecamFrozenRoot.Anchored = false
		freecamFrozenRoot = nil
	end
end

local function startFreecam()
	if freecamActive then
		return
	end

	local camera = workspace.CurrentCamera
	if not camera then
		return
	end

	freecamActive = true
	freecamVelocity = Vector3.zero
	freecamButton.Text = "Freecam: ON"
	freecamButton.BackgroundColor3 = COLORS.AccentDim
	freecamHint.Visible = true
	freecamSpeedLabel.Visible = true
	freecamIndicator.Visible = true

	previousCameraType = camera.CameraType
	previousCameraSubject = camera.CameraSubject
	previousMouseIconEnabled = UserInputService.MouseIconEnabled
	previousMouseBehavior = UserInputService.MouseBehavior

	freecamPosition = camera.CFrame.Position
	local rx, ry = camera.CFrame:ToEulerAnglesYXZ()
	freecamPitch = rx
	freecamYaw = ry

	camera.CameraType = Enum.CameraType.Scriptable

	-- Take WASD/jump away from the character so it isn't dragged around
	-- by the default controller while the camera flies off on its own.
	if playerControls then
		playerControls:Disable()
	elseif rootPart and rootPart.Parent then
		-- Fallback if PlayerModule wasn't available in time.
		freecamFrozenRoot = rootPart
		freecamFrozenRoot.Anchored = true
	end

	freecamConnection = game:GetService("RunService").RenderStepped:Connect(function(dt)
		if not freecamActive then
			return
		end

		local lookCFrame = CFrame.Angles(0, freecamYaw, 0) * CFrame.Angles(freecamPitch, 0, 0)
		local direction = Vector3.zero

		if UserInputService:IsKeyDown(Enum.KeyCode.W) then direction += lookCFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then direction -= lookCFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then direction -= lookCFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then direction += lookCFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then direction += Vector3.yAxis end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then direction -= Vector3.yAxis end

		local sprinting = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
			or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
		local targetSpeed = sprinting and (freecamSpeed * 2.5) or freecamSpeed

		local targetVelocity = Vector3.zero
		if direction.Magnitude > 0 then
			targetVelocity = direction.Unit * targetSpeed
		end

		-- Smoothly ease toward the target velocity instead of snapping,
		-- so movement feels fluid rather than robotic.
		local smoothing = 1 - math.exp(-dt * 10)
		freecamVelocity = freecamVelocity:Lerp(targetVelocity, smoothing)

		freecamPosition += freecamVelocity * dt
		camera.CFrame = CFrame.new(freecamPosition) * lookCFrame
	end)
end

freecamButton.MouseButton1Click:Connect(function()
	if freecamActive then
		stopFreecam()
	else
		startFreecam()
	end
end)

-- Look around with the camera while Freecam is on and right mouse is held,
