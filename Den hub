-- ===== Category System =====
local categories = {}
local activeCategory = nil

local function selectCategory(name)
	if activeCategory == name then
		return
	end

	if activeCategory and categories[activeCategory] then
		local prev = categories[activeCategory]
		prev.button.BackgroundColor3 = Color3.fromRGB(25, 45, 120)
		prev.button.BackgroundTransparency = 0
		prev.page.Visible = false
	end

	local current = categories[name]

	if current then
		current.button.BackgroundColor3 = COLORS.Accent
		current.button.BackgroundTransparency = 0
		current.page.Visible = true
		activeCategory = name

		-- Automatically scan when Exploiter Detector is opened
		if name == "Exploiter Detector" and runScan then
			task.defer(function()
				runScan()
			end)
		end
	end
end

local function addCategory(name)
	local button = Instance.new("TextButton")
	button.Name = name .. "Button"
	button.Size = UDim2.new(1, 0, 0, 34)
	button.BackgroundColor3 = Color3.fromRGB(25, 45, 120)
	button.AutoButtonColor = false
	button.Text = name
	button.TextColor3 = COLORS.Text
	button.Font = Enum.Font.GothamMedium
	button.TextSize = 14
	button.Parent = sidebarList

	local buttonCorner = Instance.new("UICorner")
	buttonCorner.CornerRadius = UDim.new(0, 6)
	buttonCorner.Parent = button

	button.MouseButton1Click:Connect(function()
		selectCategory(name)
	end)

	local page = Instance.new("Frame")
	page.Name = name .. "Page"
	page.Size = UDim2.new(1, 0, 1, 0)
	page.BackgroundTransparency = 1
	page.Visible = false
	page.Parent = contentFrame

	categories[name] = {
		button = button,
		page = page
	}

	return page
end

