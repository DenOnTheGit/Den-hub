		-- the edge of the screen and stop generating movement — that's
		-- what made looking around feel like it "stopped working."
		if freecamActive then
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		end
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		freecamRightMouseDown = false

		if freecamActive then
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		end
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not freecamActive then
		return
	end

	if freecamRightMouseDown and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Delta
		freecamYaw -= delta.X * 0.0025
		freecamPitch = math.clamp(freecamPitch - delta.Y * 0.0025, math.rad(-85), math.rad(85))
	elseif input.UserInputType == Enum.UserInputType.MouseWheel then
		setFreecamSpeed(freecamSpeed + input.Position.Z * (freecamSpeed * 0.15 + 5))
	end
end)

