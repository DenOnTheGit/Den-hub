local categories = {}
local activeCategory = nil
local refreshTeleportList -- forward declaration so selectCategory can call it

local function selectCategory(name)
	if activeCategory == name then
		return
	end

	if activeCategory and categories[activeCategory] then
		local prev = categories[activeCategory]
		prev.button.BackgroundColor3 = Color3.fromRGB(25, 45, 120)
		prev.button.BackgroundTransparency = 0
		prev.page.Visible = false
	end

	local current = categories[name]

	if current then
		current.button.BackgroundColor3 = COLORS.Accent
		current.button.BackgroundTransparency = 0
		current.page.Visible = true
		activeCategory = name

		-- Automatically refresh the player list when Teleport is opened
		if name == "Teleport" then
			task.defer(function()
				refreshTeleportList()
			end)
		end
	end
end

