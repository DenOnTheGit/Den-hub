-- ===== Heuristic check loop =====
local function sdCheckPlayer(player, data)
	local character = player.Character
	if not character then
		data.statusLabel.Text = "No character"
		data.statusLabel.TextColor3 = COLORS.SubText
		return
	end

	local playerHumanoid = character:FindFirstChildOfClass("Humanoid")
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not playerHumanoid or not hrp then
		return
	end

	local reasons = {}
	local now = os.clock()
	local dt = math.max(now - data.lastCheck, 0.01)

	-- Speed check: distance traveled since last check.
	local pos = hrp.Position
	if data.lastPos then
		local dist = (pos - data.lastPos).Magnitude
		local studsPerSec = dist / dt
		if studsPerSec > SD_SPEED_FLAG_THRESHOLD then
			table.insert(reasons, string.format("Speed %.0f studs/s", studsPerSec))
		end
	end
	data.lastPos = pos

	-- Floating check: not touching any ground with near-zero vertical
	-- velocity sustained for SD_FLOAT_TIME_THRESHOLD seconds. We use
	-- FloorMaterial == Air rather than just HumanoidState, because most
	-- fly/hover exploits move the character directly via velocity/CFrame
	-- and never actually trigger Roblox's Freefall or Jumping state —
	-- they'll often sit in Running, Physics, or PlatformStand instead.
	-- FloorMaterial reflects whether they're really touching ground,
	-- regardless of what state the exploit script fakes.
	--
	-- Important: FloorMaterial == Air by itself is NOT enough — every
	-- normal jump or step off a ledge briefly reads Air too. What actually
	-- distinguishes a hover/fly exploit is that gravity keeps accelerating
	-- a real falling player's Y velocity, while a hover hack keeps it
	-- pinned near zero. So we only count time toward these flags while
	-- BOTH conditions hold: off the ground AND velocity isn't behaving
	-- like normal gravity.
	local state = playerHumanoid:GetState()
	local isOffGround = playerHumanoid.FloorMaterial == Enum.Material.Air
		or state == Enum.HumanoidStateType.Freefall
		or state == Enum.HumanoidStateType.Jumping
		or state == Enum.HumanoidStateType.Physics
		or state == Enum.HumanoidStateType.PlatformStand

	local yVel = hrp.AssemblyLinearVelocity.Y
	local suspendedInAir = isOffGround and math.abs(yVel) <= SD_FLOAT_VELOCITY_TOLERANCE

	if suspendedInAir then
		data.floatTime += dt
	else
		data.floatTime = 0
	end

	if data.floatTime >= SD_FLOAT_TIME_THRESHOLD then
		table.insert(reasons, string.format("Floating %.1fs", data.floatTime))
	end

	-- Sustained hover time: same "suspended in air" signal, just a longer
	-- threshold. This intentionally will NOT flag a long normal fall,
	-- since a real fall keeps accelerating (large |yVel|) rather than
	-- sitting near zero.
	if suspendedInAir then
		data.freefallTime += dt
	else
		data.freefallTime = 0
	end

	if data.freefallTime >= SD_FREEFALL_TIME_THRESHOLD then
		table.insert(reasons, string.format("Hovering %.1fs", data.freefallTime))
	end

	data.lastCheck = now

	sdSetStatus(data.statusLabel, #reasons == 0, reasons)
end

