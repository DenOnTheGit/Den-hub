	end

	table.sort(others, function(a, b)
		return a.Name:lower() < b.Name:lower()
	end)

	teleportEmptyLabel.Visible = (#others == 0)

	for i, player in ipairs(others) do
		addTeleportRow(i, player)
	end
end

