local function flingPlayer(targetPlayer)
	if not targetPlayer or not targetPlayer.Parent then
		return false, "Target left the server."
	end

	local targetCharacter = targetPlayer.Character
	local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
	if not targetRoot then
		return false, "Target has no HumanoidRootPart."
	end

	if not rootPart or not rootPart.Parent then
		updateCharacter()
	end

	if not rootPart then
		return false, "Your character is unavailable."
	end

	-- Short physics burst toward the selected player.
	-- This is intentionally client-side; the game decides whether the
	-- character is network-owned enough for the interaction to replicate.
	local oldAutoRotate = humanoid and humanoid.AutoRotate
	if humanoid then
		humanoid.AutoRotate = false
	end

	local direction = targetRoot.Position - rootPart.Position
	if direction.Magnitude < 1 then
		direction = targetRoot.CFrame.LookVector
	else
		direction = direction.Unit
	end

	local burst = direction * 220 + Vector3.new(0, 55, 0)
	rootPart.AssemblyLinearVelocity = burst

	task.delay(0.35, function()
		if rootPart and rootPart.Parent then
			rootPart.AssemblyLinearVelocity = Vector3.zero
		end
		if humanoid and humanoid.Parent and oldAutoRotate ~= nil then
			humanoid.AutoRotate = oldAutoRotate
		end
	end)

	return true
end

local function refreshFlingList()
	clearFlingList()

	local others = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= localPlayer then
			table.insert(others, player)
		end
	end

	table.sort(others, function(a, b)
		return a.Name:lower() < b.Name:lower()
	end)

	for index, player in ipairs(others) do
		local button = Instance.new("TextButton")
