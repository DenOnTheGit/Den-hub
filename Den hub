-- Update loop (every 0.5s per player is plenty; avoid hammering every frame).
local sdAccum = 0
RunService.Heartbeat:Connect(function(dt)
	sdAccum += dt
	if sdAccum < 0.5 then
		return
	end
	sdAccum = 0

	for player, data in pairs(sdTracked) do
		local ok, err = pcall(sdCheckPlayer, player, data)
		if not ok then
			warn("Script Detector check failed for " .. player.Name .. ": " .. tostring(err))
		end
	end
end)

