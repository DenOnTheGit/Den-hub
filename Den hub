local function stopAntiForceTeleport()
	antiForceTeleport = false

	if antiForceTeleportConnection then
		antiForceTeleportConnection:Disconnect()
		antiForceTeleportConnection = nil
	end

	antiForceTeleportButton.Text = "Anti Force Teleport: OFF"
	antiForceTeleportButton.BackgroundColor3 = COLORS.Accent
	lastSafePosition = nil
end

local function startAntiForceTeleport()
	if antiForceTeleport then
		return
	end

	antiForceTeleport = true
	teleportCheckCooldown = 0

	if rootPart and rootPart.Parent then
		lastSafePosition = rootPart.CFrame
	end

	antiForceTeleportButton.Text = "Anti Force Teleport: ON"
	antiForceTeleportButton.BackgroundColor3 = COLORS.AccentDim

	antiForceTeleportConnection = game:GetService("RunService").Heartbeat:Connect(function(dt)
		if not antiForceTeleport or not rootPart or not rootPart.Parent then return end
		teleportCheckCooldown -= dt
		if teleportCheckCooldown > 0 then return end
		teleportCheckCooldown = 0.1

		local currentPosition = rootPart.Position
		if lastSafePosition then
			local distance = (currentPosition - lastSafePosition.Position).Magnitude
			if distance > 100 then
				rootPart.CFrame = lastSafePosition
				rootPart.AssemblyLinearVelocity = Vector3.zero
				rootPart.AssemblyAngularVelocity = Vector3.zero
				return
			end
		end
		lastSafePosition = rootPart.CFrame
	end)
end

antiForceTeleportButton.MouseButton1Click:Connect(function()
	if antiForceTeleport then
		stopAntiForceTeleport()
	else
		startAntiForceTeleport()
	end
end)

