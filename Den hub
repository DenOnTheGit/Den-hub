local mm2EspEnabled, mm2RoleEspEnabled = false, false
local mm2ToolEspEnabled, mm2NameDistanceEnabled = false, false
local mm2TracerEnabled = false
local mm2Data = {}

local MM2_ROLE_NAMES = {Murderer="Murderer", Sheriff="Sheriff", Hero="Hero", Innocent="Innocent"}
local MM2_ROLE_KEYS = {"Role", "RoleName", "PlayerRole"}

local function mm2RoleColor(role)
	if role == "Murderer" then return Color3.fromRGB(235,80,80) end
	if role == "Sheriff" then return Color3.fromRGB(80,150,255) end
	if role == "Hero" then return Color3.fromRGB(255,210,70) end
	if role == "Innocent" then return Color3.fromRGB(120,220,140) end
	return Color3.fromRGB(180,180,180)
end

local function mm2NormalizeRole(value)
	if typeof(value) ~= "string" then return nil end
	local clean = value:gsub("^%s+", ""):gsub("%s+$", ""):lower()
	for key, role in pairs(MM2_ROLE_NAMES) do
		if clean == key:lower() then return role end
	end
	return nil
end

local function mm2GetRole(player)
	local char = player.Character
	if not char then return "Unknown" end
	for _, key in ipairs(MM2_ROLE_KEYS) do
		local role = mm2NormalizeRole(player:GetAttribute(key)) or mm2NormalizeRole(char:GetAttribute(key))
		if role then return role end
	end
	for _, container in ipairs({player, char}) do
		for _, obj in ipairs(container:GetChildren()) do
			if obj:IsA("StringValue") then
				local role = mm2NormalizeRole(obj.Value)
				if role then return role end
			end
		end
	end
	for _, obj in ipairs(char:GetChildren()) do
		if obj:IsA("Tool") then
			local n = obj.Name:lower()
			if n:find("knife") then return "Murderer" end
			if n:find("gun") or n:find("revolver") then return "Sheriff" end
		end
	end
	return "Unknown"
end

local function mm2ClearVisuals(player)
	local data = mm2Data[player]
	if not data then return end
	if data.highlight then data.highlight:Destroy() end
	if data.toolHighlights then
		for _, h in pairs(data.toolHighlights) do if h then h:Destroy() end end
	end
	if data.billboard then data.billboard:Destroy() end
	if data.tracer then
		if data.tracer.beam then data.tracer.beam:Destroy() end
		if data.tracer.a0 then data.tracer.a0:Destroy() end
		if data.tracer.a1 then data.tracer.a1:Destroy() end
	end
	data.highlight, data.billboard, data.tracer = nil, nil, nil
	data.toolHighlights = nil
end

local function mm2EnsureData(player)
	local data = mm2Data[player]
	if not data then
		data = {signature = "", role = "Unknown", connections = {}}
		mm2Data[player] = data
	end
	return data
end

local function mm2MakeTracer(player, head, role)
	local localChar = localPlayer.Character
	local localHead = localChar and localChar:FindFirstChild("Head")
	if not localHead then return nil end
	local a0 = Instance.new("Attachment")
	local a1 = Instance.new("Attachment")
	local beam = Instance.new("Beam")
	a0.Name, a1.Name, beam.Name = "ProjectDenMM2TracerStart", "ProjectDenMM2TracerEnd", "ProjectDenMM2Tracer"
	a0.Parent, a1.Parent = localHead, head
	beam.Attachment0, beam.Attachment1 = a0, a1
	beam.FaceCamera = true
	beam.Width0, beam.Width1 = 0.035, 0.035
	beam.LightEmission = 1
	beam.Transparency = NumberSequence.new(0.15)
	beam.Color = ColorSequence.new(mm2RoleColor(role))
	beam.Parent = localHead
	return {beam=beam, a0=a0, a1=a1}
end

local function mm2Signature(player, role)
	local char = player.Character
	if not char then return "no-character" end
	local toolNames = {}
	for _, obj in ipairs(char:GetChildren()) do
		if obj:IsA("Tool") then toolNames[#toolNames+1] = obj.Name end
	end
	table.sort(toolNames)
	return tostring(char) .. "|" .. role .. "|" .. table.concat(toolNames, ";") .. "|" .. tostring(mm2EspEnabled) .. tostring(mm2RoleEspEnabled) .. tostring(mm2ToolEspEnabled) .. tostring(mm2NameDistanceEnabled) .. tostring(mm2TracerEnabled)
end

local function mm2ApplyPlayer(player, force)
	if player == localPlayer or not player.Character then return end
	local data = mm2EnsureData(player)
	local role = mm2GetRole(player)
	local sig = mm2Signature(player, role)
	if not force and data.signature == sig then return end
	data.signature, data.role = sig, role
	mm2ClearVisuals(player)

	local char, head = player.Character, player.Character:FindFirstChild("Head")
	if mm2EspEnabled then
		local h = Instance.new("Highlight")
		h.Name, h.Adornee = "ProjectDenMM2ESP", char
		h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		h.FillTransparency, h.OutlineTransparency = 0.65, 0.05
		h.FillColor = mm2RoleEspEnabled and mm2RoleColor(role) or COLORS.Accent
		h.OutlineColor = mm2RoleEspEnabled and mm2RoleColor(role) or COLORS.Text
		h.Parent = char
		data.highlight = h
	end

	if head and (mm2RoleEspEnabled or mm2NameDistanceEnabled) then
		local billboard = Instance.new("BillboardGui")
		billboard.Name, billboard.Adornee = "ProjectDenMM2Role", head
		billboard.Size = UDim2.new(0,180,0,mm2NameDistanceEnabled and 42 or 26)
		billboard.StudsOffset = Vector3.new(0, mm2NameDistanceEnabled and 3.6 or 3, 0)
		billboard.AlwaysOnTop = true
		billboard.Parent = head
		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1,0,1,0)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBold
		label.TextSize = mm2NameDistanceEnabled and 12 or 13
		label.TextStrokeTransparency = 0.35
		label.TextColor3 = mm2RoleColor(role)
		label.Text = mm2NameDistanceEnabled and (player.DisplayName .. " [" .. role .. "]\nDistance: --") or role
		label.Parent = billboard
		data.billboard = billboard
	end

	if mm2ToolEspEnabled then
		data.toolHighlights = {}
		for _, obj in ipairs(char:GetChildren()) do
			if obj:IsA("Tool") and obj:FindFirstChildWhichIsA("BasePart", true) then
				local h = Instance.new("Highlight")
				h.Name, h.Adornee = "ProjectDenMM2ToolESP", obj
				h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				h.FillTransparency = 0.45
				h.OutlineTransparency = 0
				local n = obj.Name:lower()
				h.FillColor = n:find("knife") and Color3.fromRGB(235,80,80) or Color3.fromRGB(80,150,255)
				h.OutlineColor = COLORS.Text
				h.Parent = obj
				data.toolHighlights[obj] = h
			end
		end
	end

	if mm2TracerEnabled and head then data.tracer = mm2MakeTracer(player, head, role) end
end

local function mm2Refresh(force)
	if not (mm2EspEnabled or mm2RoleEspEnabled or mm2ToolEspEnabled or mm2NameDistanceEnabled or mm2TracerEnabled) then
		if force then for player in pairs(mm2Data) do mm2ClearVisuals(player) end end
		return
	end
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= localPlayer then mm2ApplyPlayer(player, force) end
	end
end

local function mm2WatchPlayer(player)
	local data = mm2EnsureData(player)
	for _, c in ipairs(data.connections) do c:Disconnect() end
	table.clear(data.connections)
	local function changed() task.defer(mm2ApplyPlayer, player, true) end
	if player.Character then
		local char = player.Character
		table.insert(data.connections, char.ChildAdded:Connect(changed))
		table.insert(data.connections, char.ChildRemoved:Connect(changed))
		table.insert(data.connections, char.AttributeChanged:Connect(changed))
	end
	for _, key in ipairs(MM2_ROLE_KEYS) do
		table.insert(data.connections, player:GetAttributeChangedSignal(key):Connect(changed))
	end
	table.insert(data.connections, player.CharacterAdded:Connect(function(char)
		mm2ClearVisuals(player)
		task.defer(mm2WatchPlayer, player)
		task.defer(mm2ApplyPlayer, player, true)
	end))
	task.defer(mm2ApplyPlayer, player, true)
end

