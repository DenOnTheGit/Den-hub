-- (Moved here from the server script — it's a client-only visual toggle
-- and must live in the LocalScript so it can see `mainPage` and `COLORS`.)
local ProjectDenNoclip = false
local ProjectDenNoclipConnection
local noclipParts = {}

local function rebuildNoclipParts(char)
	noclipParts = {}
	if not char then return end
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") then
			noclipParts[#noclipParts + 1] = part
			part.CanCollide = false
		end
	end
end

local function setNoclip(enabled)
	ProjectDenNoclip = enabled
	if ProjectDenNoclipConnection then
		ProjectDenNoclipConnection:Disconnect()
		ProjectDenNoclipConnection = nil
	end

	local char = localPlayer.Character
	if enabled then
		rebuildNoclipParts(char)
		ProjectDenNoclipConnection = game:GetService("RunService").Heartbeat:Connect(function()
			if not ProjectDenNoclip then return end
			for i = #noclipParts, 1, -1 do
				local part = noclipParts[i]
				if part and part.Parent then
					if part.CanCollide then part.CanCollide = false end
				else
					table.remove(noclipParts, i)
				end
			end
		end)
	else
		for _, part in ipairs(noclipParts) do
			if part and part.Parent then part.CanCollide = true end
		end
		noclipParts = {}
	end
end

localPlayer.CharacterAdded:Connect(function(char)
	if ProjectDenNoclip then
		task.defer(rebuildNoclipParts, char)
	end
end)

